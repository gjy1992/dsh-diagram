{
  "name": "dsh-diagram",
  "version": "0.1.0",
  "private": true,
  "description": "YAML 驱动的架构图引擎（零图布局依赖）+ 可安装的 dsh 插件：对话内深色卡片预览与 .drawio 导出",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "cli": "tsx packages/core/src/cli.ts",
    "validate": "tsx packages/core/src/cli.ts validate",
    "build:examples": "tsx packages/core/src/cli.ts build-all examples -o out",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "audit:routing": "tsx scripts/audit-routing.ts",
    "build:plugin": "node scripts/build-plugin.mjs",
    "typecheck:plugin": "node scripts/typecheck-plugin.mjs",
    "verify:activation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-plugin-activation.ps1",
    "roundtrip": "tsx scripts/roundtrip-check.ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
